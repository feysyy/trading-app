<main>
  <p class="
    text-center py-6 text-3xl
  ">
    Welcome to trading app
  </p>


  <section class="
    text-center
  
  ">
    <div class="
      py-10
    ">
      <%= form_for(@resource, as: @resource_name, url: session_path(@resource_name)) do |f| %>
        <% if flash[:alert] %>
            <div class="text-red-600 mb-2"><%= flash[:alert] %></div>
        <% end %>
        <div class="field">
          <%= f.label :email %><br />
          <%= f.email_field :email, class: "px-1 focus:outline-none border rounded-md" %>
        </div>

        <div class="field">
          <%= f.label :password %><br />
          <%= f.password_field :password, class: "px-1 focus:outline-none border rounded-md"%>
        </div>

        <div class="actions">
          <%= f.submit "Log in", class: "px-1 mt-4 mb-2 border rounded-md" %>
        </div>
      <% end %>
    </div>
    
    <div class="
      py-10
    "> 
      <p>Doesn't have an account yet?</p>
      <p>
        Click 
        <span>
          <%= link_to "Sign-Up", new_user_registration_path, class: "
            text-blue-400 underline
          " %>
        </span> to register
      </p>
    </div>
  </section>
</main>