<header class="mb-4">
  <div class="mt-4 ml-4"><%= link_to "Back", admin_users_path, class: "pl-1 pr-1 border rounded-md" %></div>
</header>

<Main class="text-center">
  <p class="mb-2 pl-4 text-left">Transactions</p>

  <section class="
    max-w-sm mx-auto
    sm:max-w-md
    md:max-w-lg
  ">
    <div class="
      p-4 mb-4 mx-2 flex flex-col justify-center
      xl:border-none
    ">
      <p class="underline">Buy</p>
      <table>
        <thead>
          <tr class="">
            <th >Symbol</th>
            <th>Price</th>
            <th>Quantity</th>
          </tr>
        </thead>

        <tbody>
        <% @orders.each do |order| %>
          <% if order.order_type == "buy" %>
            <tr>
              <td class="border border-blue-200 text-green-600 "><%= order.company.symbol %></td>
              <td class="border border-blue-200 text-green-600"><%= order.price %></td>
              <td class="border border-blue-200 text-green-600"><%= order.quantity %></td>
            </tr>
          <% end %>
        <% end %>
        </tbody>
      </table>
    </div>

    <div class="
      p-4 mt-4 mx-2 flex flex-col justify-center
      xl:border-none
    ">
      <p class="underline">Sell</p>
      <table>
        <thead>
          <tr>
            <th>Symbol</th>
            <th>Price</th>
            <th>Quantity</th>
          </tr>
        </thead>

        <tbody>
        <% @orders.each do |order| %>
          <% if order.order_type == "sell" %>
            <tr>
              <td class="border border-blue-200 text-red-600"><%= order.company.symbol %></td>
              <td class="border border-blue-200 text-red-600"><%= order.price %></td>
              <td class="border border-blue-200 text-red-600"><%= order.quantity %></td>
            </tr>
          <% end %>
        <% end %>
        </tbody>
      </table>
    </div>
  </section>

</Main>