<div class="
  flex justify-center
">
  <%= form_with model: [:admin, @user] do |form| %>
    <div>
      <%= form.label :email %>
      <br>
      <%= form.email_field :email, class: "px-1 border rounded-md"  %>
    </div>

    <div>
      <%= form.label :password %>
      <br>
      <%= form.password_field :password, class: "px-1 border rounded-md" %>
    </div>

    <div>
      <%= form.label :password_confirmation %>
      <br>
      <%= form.password_field :password_confirmation, class: "px-1 border rounded-md" %>
    </div>

    <div>
      <%= form.label :balance %>
      <br>
      <%= form.number_field :balance, class: "px-1 border rounded-md" %>
    </div>

    <div>
      <%= form.label :verified %>
      <%= form.check_box :verified, class: "px-1 border rounded-md" %>
    </div>

    <div>
      <%= form.submit class: "px-1 border rounded-md" %>
    </div>
  <% end %>
</div>
