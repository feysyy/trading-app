<header>
  <div class="mt-4 ml-4">
    <%= link_to "Back", admin_users_path, class: "pl-1 pr-1 border rounded-md" %>
  </div>
</header>
<main class="mt-4 px-8">
  <section>
    <p>Email:  <%= @user.email %></p>
    <p>Status: <%= @user.status %></p>
    <p>Balance: <%= @user.balance %></p>
  </section>

  <section class="mt-5">
    <%= link_to "Edit account", edit_admin_user_path(@user), class: "pl-1 pr-1 border rounded-md" %>
  </section>

</main>