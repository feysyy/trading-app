<header class="
  p-2 flex justify-between

">
  <div>
    <%= link_to "Home", landing_page_path, class: "px-1 border rounded-md" %>
  </div>

  <div>
    <%= link_to "My portfolio", portfolio_path, class: "px-1 border rounded-md" %>
  </div>

  <div class="underline">
    Balance: <%= current_user.balance %>
  </div>
</header>

<main class="
  max-w-sm mx-auto
  sm:max-w-md
  md:max-w-xl
  lg:max-w-2xl
">
  <p class="text-center text-2xl">Marketplace</p>
  <section class="
    sm:grid sm:grid-cols-2 sm:grid-rows-5 sm:gap-4
    md:grid md:grid-cols-3 md:grid-rows-2
    xl:grid xl:grid-cols-3
    2xl:grid 2xl:grid-cols-3
  ">
    <% @companies.each do |company| %>
      <div class="m-4 p-2 border rounded-md">
        <p> <%= link_to "#{company.name} - #{ company.symbol}", company_path(company) %> </p>
        <%# line # 22 shows how to display prices of each company stock in index %>
        <%# <%= @price[company.symbol] %>

        <%# For line #27 showing all prices in one page is not efficient as -  %>
        <%# it takes a lot of time to load the price data  %>
        <%# because of API limitation %>    
        <p>Please select the company to see the current price</p>
      </div>
    <% end %>
  </section>

</main>