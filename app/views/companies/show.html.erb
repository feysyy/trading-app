<header class="m-4 flex justify-between">
  <p><%= link_to "Home", landing_page_path, class: "pl-1 pr-1 border rounded-md" %></p>
  <p><%= link_to "Marketplace", companies_path, class: "pl-1 pr-1 border rounded-md" %></p>
  <p><%= link_to "My Portfolio", portfolio_path, class: "pl-1 pr-1 border rounded-md" %></p>
</header>

<main>
  <p class="underline m-6">Balance: <%= current_user.balance %></p>

  <section class="m-2 p-4 mx-auto text-center">
    <% if @stock %>
      <h1><%= @company.name %></h1>
      <p>Price: <%= @stock_price.first["price"].round(2) %></p>
      <p>Share: <%= @stock.quantity %></p>
      <%= form_with model: [@company, @order], local: true do |f|  %>
        <div>
          <%= f.number_field :quantity, placeholder: "Enter quantity", class: "pl-1 pr-1 border rounded-md text-center appearance-none" %>
        </div>

        <div>
          <%= f.submit "Buy", name: "order[order_type]", value: "buy", class: "mt-4 mr-2 pl-2 pr-2 border rounded-md" %>
          <%= f.submit "Sell", name: "order[order_type]", value: "sell", class: "mt-4 ml-2 pl-2 pr-2 border rounded-md" %>
        </div>
      <% end %>
    <% else %>
      <h1><%= @company.name %></h1>
      <p>Price: <%= @stock_price.first["price"].round(2) %></p>
      <p>Share: You don't own a share of this company yet</p>
      
      <% if current_user.verified %>
        <%= form_with model: [@company, @order], local: true do |f|  %>
          <div>
            <%= f.number_field :quantity, placeholder: "Enter quantity", class: "mt-2 pl-1 pr-1 border rounded-md text-center" %>
          </div>
          <div>
            <%= f.submit "Buy", name: "order[order_type]", value: "buy", class: "mt-4 ml-2 pl-2 pr-2 border rounded-md" %>   
          </div>
        <% end %>
      <% else %>
        <p>Account status needs to be verified before you can access buy and sell </p>
      <% end %>
    <% end %>
  </section>
</main>