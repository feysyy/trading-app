<%= link_to "Home", landing_page_path %>
<br>
<%= link_to "Marketplace", companies_path %>
<h1>My portfolio</h1>
<section>

<% if current_user.verified %>
  <% @stocks.each do |stock| %>
    <p><%= stock.id %></p>
    <p>Symbol: <%= stock.company.symbol %></p>
    <p>Company name: <%= stock.company.name %></p>
    <%= link_to "View", company_path(stock.company) %>
  <% end %>
<% else %>
  <p>Account status needs to be verified</p>
<% end %>



</section>